if(NOT CMAKE_CROSSCOMPILING OR NOT MICROS_STACK_BUILD_MODE STREQUAL "observed")
    message(FATAL_ERROR "Observer support requires the explicit RV64 observed mode")
endif()
if(NOT MICROS_BUILD_SCHEDULER_TEST AND NOT MICROS_BUILD_IPC_SYSCALL_TEST AND NOT MICROS_BUILD_GRANT_SYSCALL_TEST AND NOT MICROS_BUILD_BOOTSTRAP_LAUNCHER_TEST AND NOT MICROS_BUILD_VM_SCRATCH_PREEMPTION_TEST AND NOT MICROS_BUILD_PM_SERVICE_TEST AND NOT MICROS_BUILD_TTY_SERVICE_TEST AND NOT MICROS_BUILD_RAMFS_SERVICE_TEST AND NOT MICROS_BUILD_VFS_SERVICE_TEST AND NOT MICROS_BUILD_ELF_SPAWN_TEST)
    message(FATAL_ERROR "The current observer slice admits only its declared components")
endif()
add_compile_options("$<$<COMPILE_LANGUAGE:C>:-fstack-usage;-fstack-size-section;-finstrument-functions-after-inlining>")
function(micros_stack_bind_observer)
    if(NOT TARGET micros)
        message(FATAL_ERROR "Observer support lacks its exact kernel target")
    endif()
    target_sources(micros PRIVATE tests/stack/observer.S tests/stack/observer.c)
    target_compile_definitions(micros PRIVATE MICROS_STACK_OBSERVER_KERNEL=1)
    set(stack_users)
    if(MICROS_BUILD_BOOTSTRAP_LAUNCHER_TEST)
        set(stack_users micros_bootstrap_launcher micros_bootstrap_probe)
    elseif(MICROS_BUILD_VM_SCRATCH_PREEMPTION_TEST)
        set(stack_users micros_bootstrap_launcher micros_vm_server micros_pm_service micros_vm_scratch_preemption_driver)
    elseif(MICROS_BUILD_PM_SERVICE_TEST)
        set(stack_users micros_bootstrap_launcher micros_vm_server micros_pm_service micros_pm_service_probe micros_application_runtime_probe)
    elseif(MICROS_BUILD_TTY_SERVICE_TEST)
        set(stack_users micros_bootstrap_launcher micros_vm_server micros_pm_service micros_tty_service micros_tty_service_vfs)
    elseif(MICROS_BUILD_RAMFS_SERVICE_TEST)
        set(stack_users micros_bootstrap_launcher micros_vm_server micros_pm_service micros_tty_service micros_ramfs_service micros_ramfs_service_vfs)
    elseif(MICROS_BUILD_VFS_SERVICE_TEST)
        set(stack_users micros_bootstrap_launcher micros_vm_server micros_pm_service micros_tty_service micros_ramfs_service micros_vfs_service micros_vfs_service_probe)
    elseif(MICROS_BUILD_ELF_SPAWN_TEST)
        set(stack_users micros_bootstrap_launcher micros_vm_server micros_pm_service micros_tty_service micros_ramfs_service micros_vfs_service micros_elf_spawn_init micros_elf_spawn_child micros_application_runtime_probe)
    endif()
    if(stack_users)
        foreach(user_target IN LISTS stack_users)
            target_sources("${user_target}" PRIVATE tests/stack/observer.S)
            target_link_options("${user_target}" PRIVATE "-Wl,-Map,$<TARGET_FILE_DIR:${user_target}>/$<TARGET_FILE_BASE_NAME:${user_target}>.map")
        endforeach()
        set(stack_catalog "${CMAKE_BINARY_DIR}/generated/stack_observer_images.h")
        add_custom_command(OUTPUT "${stack_catalog}"
            COMMAND "${MICROS_PYTHON}" ${MICROS_PYTHON_ARGS}
                "${CMAKE_CURRENT_SOURCE_DIR}/tools/generate_stack_observer_catalog.py"
                --build "${CMAKE_BINARY_DIR}"
            DEPENDS ${stack_users}
                tools/generate_stack_observer_catalog.py tools/stack_bound_user_images.py
            WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" VERBATIM)
        target_sources(micros PRIVATE tests/stack/observer_user.c "${stack_catalog}")
        target_include_directories(micros PRIVATE "${CMAKE_BINARY_DIR}/generated")
        target_compile_definitions(micros PRIVATE MICROS_STACK_OBSERVER_USERS=1)
    endif()
    if(MICROS_BUILD_PM_SERVICE_TEST OR MICROS_BUILD_ELF_SPAWN_TEST)
        target_compile_definitions(micros PRIVATE MICROS_STACK_OBSERVER_APPLICATIONS=1)
    endif()
    if(MICROS_BUILD_TTY_SERVICE_TEST OR MICROS_BUILD_RAMFS_SERVICE_TEST OR MICROS_BUILD_VFS_SERVICE_TEST OR MICROS_BUILD_ELF_SPAWN_TEST)
        target_compile_definitions(micros PRIVATE MICROS_STACK_OBSERVER_POLLED_REPORT=1)
    endif()
endfunction()
cmake_language(DEFER CALL micros_stack_bind_observer)
