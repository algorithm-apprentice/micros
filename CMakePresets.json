{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Native host tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MICROS_BUILD_HOST_TESTS": "ON"
      }
    },
    {
      "name": "riscv64-debug",
      "displayName": "RISC-V 64 debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/riscv64-debug",
      "toolchainFile": "${sourceDir}/cmake/toolchains/riscv64-clang.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "riscv64-panic-test",
      "displayName": "RISC-V 64 intentional panic test",
      "inherits": "riscv64-debug",
      "binaryDir": "${sourceDir}/build/riscv64-panic-test",
      "cacheVariables": {
        "MICROS_BUILD_PANIC_TEST": "ON"
      }
    },
    {
      "name": "riscv64-trap-test",
      "displayName": "RISC-V 64 trap recovery test",
      "inherits": "riscv64-debug",
      "binaryDir": "${sourceDir}/build/riscv64-trap-test",
      "cacheVariables": {
        "MICROS_BUILD_TRAP_TEST": "ON"
      }
    },
    {
      "name": "riscv64-trap-panic-test",
      "displayName": "RISC-V 64 unexpected trap panic test",
      "inherits": "riscv64-debug",
      "binaryDir": "${sourceDir}/build/riscv64-trap-panic-test",
      "cacheVariables": {
        "MICROS_BUILD_TRAP_PANIC_TEST": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "test-unit",
      "configurePreset": "host-debug",
      "targets": [
        "test-unit"
      ]
    },
    {
      "name": "riscv64-debug",
      "configurePreset": "riscv64-debug"
    },
    {
      "name": "test-qemu-smoke",
      "configurePreset": "riscv64-debug",
      "targets": [
        "test-qemu-smoke"
      ]
    },
    {
      "name": "test-qemu-panic",
      "configurePreset": "riscv64-panic-test",
      "targets": [
        "test-qemu-panic"
      ]
    },
    {
      "name": "test-qemu-trap",
      "configurePreset": "riscv64-trap-test",
      "targets": [
        "test-qemu-trap"
      ]
    },
    {
      "name": "test-qemu-trap-panic",
      "configurePreset": "riscv64-trap-panic-test",
      "targets": [
        "test-qemu-trap-panic"
      ]
    }
  ],
  "workflowPresets": [
    {
      "name": "test-unit",
      "displayName": "Build and run native unit tests",
      "steps": [
        {
          "type": "configure",
          "name": "host-debug"
        },
        {
          "type": "build",
          "name": "test-unit"
        }
      ]
    },
    {
      "name": "build-riscv64-debug",
      "displayName": "Configure and build the RISC-V 64 debug image",
      "steps": [
        {
          "type": "configure",
          "name": "riscv64-debug"
        },
        {
          "type": "build",
          "name": "riscv64-debug"
        }
      ]
    },
    {
      "name": "test-qemu-smoke",
      "displayName": "Build and run the QEMU boot smoke test",
      "steps": [
        {
          "type": "configure",
          "name": "riscv64-debug"
        },
        {
          "type": "build",
          "name": "test-qemu-smoke"
        }
      ]
    },
    {
      "name": "test-qemu-panic",
      "displayName": "Build and run the intentional panic test",
      "steps": [
        {
          "type": "configure",
          "name": "riscv64-panic-test"
        },
        {
          "type": "build",
          "name": "test-qemu-panic"
        }
      ]
    },
    {
      "name": "test-qemu-trap",
      "displayName": "Build and run the trap recovery test",
      "steps": [
        {
          "type": "configure",
          "name": "riscv64-trap-test"
        },
        {
          "type": "build",
          "name": "test-qemu-trap"
        }
      ]
    },
    {
      "name": "test-qemu-trap-panic",
      "displayName": "Build and run the unexpected trap panic test",
      "steps": [
        {
          "type": "configure",
          "name": "riscv64-trap-panic-test"
        },
        {
          "type": "build",
          "name": "test-qemu-trap-panic"
        }
      ]
    }
  ]
}
