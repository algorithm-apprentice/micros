          "name": "riscv64-frame-allocator-test"
        },
        {
          "type": "build",
          "name": "test-qemu-frame-allocator"
        }
      ]
    },
    {
      "name": "test-qemu-trap-panic",
      "displayName": "Build and run the unexpected trap panic test",
      "steps": [
        {
          "type": "configure",
          "name": "riscv64-trap-panic-test"
        },
        {
          "type": "build",
          "name": "test-qemu-trap-panic"
        }
      ]
    },
    {
      "name": "test-qemu-mmu",
      "displayName": "Build and run the Sv39 MMU test",
      "steps": [
        {
          "type": "configure",
          "name": "riscv64-mmu-test"
        },
        {
          "type": "build",
          "name": "test-qemu-mmu"
        }
      ]
    },
    {
      "name": "test-qemu-object-model",
      "displayName": "Build and run the kernel object model test",
      "steps": [
        {
          "type": "configure",
          "name": "riscv64-object-model-test"
        },
        {
          "type": "build",
          "name": "test-qemu-object-model"
        }
      ]
